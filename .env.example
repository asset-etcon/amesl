# Aiven PostgreSQL connection (Service URI from Aiven Console -> Overview -> Connection information)
# Use sslmode=require in the URI. A self-signed cert is expected; set PG_SSL=false only for local dev
# against a non-TLS Postgres (never in production).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Optional: fine-tune the client-side pool (low plans have few Postgres connections).
PG_POOL_MAX=5

# Session signing key — generate a long random string (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Cloudflare R2 (S3-compatible object storage)
# Account ID: R2 dashboard Overview. Keys: R2 -> Manage Account -> R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for objects (bucket must be public). e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=