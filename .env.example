# Aiven PostgreSQL connection (Service URI from Aiven Console -> Overview -> Connection information)
# Use sslmode=require in the URI. A self-signed cert is expected; set PG_SSL=false only for local dev
# against a non-TLS Postgres (never in production).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Postgres pool size. Keep this SMALL in production: every serverless instance
# opens its own pool, and the Aiven plan allows only ~17 non-superuser
# connections in total. 2 is the recommended production value; 5 is fine locally.
# Requests queue on the pool, so a low number costs throughput, not correctness.
PG_POOL_MAX=2

# Session signing key — generate a long random string (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Cloudflare R2 (S3-compatible object storage)
# Account ID: R2 dashboard Overview. Keys: R2 -> Manage Account -> R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for objects (bucket must be public). e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Transactional email (Resend)
# API key: Resend dashboard -> API Keys -> Create API Key (send access only).
# The from-address domain must be verified in Resend first (Domains -> Add Domain).
RESEND_API_KEY=
# Verified sender, e.g. notifications@yourdomain.com
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Asset Matrix Energy
# Where replies to the customer acknowledgement should go. Defaults to MAIL_FROM_EMAIL.
MAIL_REPLY_TO_EMAIL=
# Comma-separated internal recipients for new quote requests.
# If unset or invalid, requests are still saved and the admin dashboard is the source of truth.
QUOTE_NOTIFY_EMAILS=sales@yourdomain.com
# Absolute site origin, used for links inside emails. Leave blank on Vercel to auto-detect.
SITE_URL=